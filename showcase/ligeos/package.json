{
  "name": "ligeos",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"npm run dev --workspace @ligeos/frontend\" \"npm run dev --workspace @ligeos/backend\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:frontend": "npm run dev --workspace @ligeos/frontend",
    "dev:backend": "npm run dev --workspace @ligeos/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
